
def length_converter():
    print("LENGTH CONVERTOR")
    print("1. Meters to Kilometers")
    print("2. Kilometers to Meters")
    print("3. Feet to Meters")
    print("4. Meters to Feet")
    
    choice = input("Select an option (1-4): ")
    
    try:
        if choice == '1':
            m = float(input("Enter length in meters: "))
            print(f"Result: {m} meters = {m / 1000} kilometers")
        elif choice == '2':
            km = float(input("Enter length in kilometers: "))
            print(f"Result: {km} kilometers = {km * 1000} meters")
        elif choice == '3':
            ft = float(input("Enter length in feet: "))
            print(f"Result: {ft} feet = {ft * 0.3048} meters")
        elif choice == '4':
            m = float(input("Enter length in meters: "))
            print(f"Result: {m} meters = {m * 3.28084} feet")
        else:
            print(" Invalid option choice!")
    except ValueError:
        print(" Error: Please enter a valid number.")


def weight_converter():
    print(" WEIGHT CONVERTOR")
    print("1. Kilograms to Grams")
    print("2. Grams to Kilograms")
    print("3. Kilograms to Pounds")
    print("4. Pounds to Kilograms")
    
    choice = input("Select an option (1-4): ")
    
    try:
        if choice == '1':
            kg = float(input("Enter weight in kilograms: "))
            print(f"Result: {kg} kg = {kg * 1000} grams")
        elif choice == '2':
            g = float(input("Enter weight in grams: "))
            print(f"Result: {g} grams = {g / 1000} kg")
        elif choice == '3':
            kg = float(input("Enter weight in kilograms: "))
            print(f"Result: {kg} kg = {kg * 2.20462} pounds")
        elif choice == '4':
            lbs = float(input("Enter weight in pounds: "))
            print(f"Result: {lbs} pounds = {lbs* 0.453592} kg")
        else:
            print(" Invalid option choice!")
    except ValueError:
        print("Error: Please enter a valid number.")


def temperature_converter():
    print(" 🌡️ TEMPERATURE CONVERTOR ")
    print("1. Celsius to Fahrenheit")
    print("2. Fahrenheit to Celsius")
    print("3. Celsius to Kelvin")
    print("4. Kelvin to Celsius")
    
    choice = input("Select an option (1-4): ")
    
    try:
        if choice == '1':
            c = float(input("Enter temperature in Celsius: "))
            f = (c * 9/5) + 32
            print(f"Result: {c} C = {f} F")
        elif choice == '2':
            f = float(input("Enter temperature in Fahrenheit: "))
            c = (f - 32) * 5/9
            print(f"Result: {f} F = {c} C")
        elif choice == '3':
            c = float(input("Enter temperature in Celsius: "))
            k = c + 273.15
            print(f"Result: {c} C = {k} K")
        elif choice == '4':
            k = float(input("Enter temperature in Kelvin: "))
            c = k - 273.15
            print(f"Result: {k} K = {c} C")
        else:
            print(" Invalid option choice!")
    except ValueError:
        print(" Error: Please enter a valid number ")


def main():
    while True:
        print("\n=============================")
        print("   MAIN UNIT CONVERTER")
        print("=============================")
        print("1. Length Conversion")
        print("2. Weight Conversion")
        print("3. Temperature Conversion")
        print("4. Exit")
        
        choice = input("Enter your choice (1-4): ")
        
        if choice == '1':
            length_converter()
        elif choice == '2':
            weight_converter()
        elif choice == '3':
            temperature_converter()
        elif choice == '4':
            print("\nThank you for using the Unit Converter. Goodbye!")
            break
        else:
            print("Invalid choice! Please select between 1 and 4.")
main()